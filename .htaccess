RewriteEngine On
RewriteBase /daqu-al-jannah/

# Redirect pretty URLs for news detail using slug
RewriteRule ^([a-zA-Z0-9-]+)$ berita/detail.php?slug=$1 [L,QSA]

# Allow existing files and directories to be accessed normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]