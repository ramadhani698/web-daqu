RewriteEngine On
RewriteBase /daqu-al-jannah/

# Allow existing files and directories to be accessed normally
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Redirect pretty URLs for news detail using slug
RewriteRule ^berita/([0-9]+)/([a-zA-Z0-9-]+)$ berita/detail.php?id=$1&slug=$2 [L,QSA]